{
  "name": "uncommitted",
  "version": "0.1.0",
  "description": "Local-first CLI for generating AI coworker diary drafts from Git activity and manual notes.",
  "type": "module",
  "bin": {
    "uncommitted": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node dist/cli.js",
    "lint": "eslint src tests vitest.config.ts eslint.config.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "eslint": "^10.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^3.1.2"
  }
}
